{
  "name": "atril-pdf",
  "version": "0.3.0",
  "description": "Lector de partituras PDF libre y gratuito para músicos / Free and open-source PDF sheet music reader for musicians",
  "author": "Marcos Hernández Párraga",
  "license": "MIT",
  "homepage": "https://github.com/MarcosHernandezParraga/atril-pdf",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcosHernandezParraga/atril-pdf.git"
  },
  "private": true,
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test -- --ci",
    "postinstall": "node scripts/copy-vendor.mjs",
    "export:web": "expo export -p web --output-dir dist",
    "export:pages": "EXPO_PUBLIC_BASE_PATH=/atril-pdf expo export -p web --output-dir dist-pages && node scripts/web-pwa.mjs dist-pages /atril-pdf",
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:start": "npm run export:web && node scripts/desktop.mjs prepare && electron desktop/app",
    "desktop:dist": "npm run export:web && node scripts/desktop.mjs prepare && electron-builder --config desktop/electron-builder.config.js",
    "glyphs": "node scripts/build-glyphs.mjs",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@expo/vector-icons": "^15.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shopify/react-native-skia": "2.14.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "fflate": "^0.8.3",
    "i18next": "^26.5.12",
    "intl-pluralrules": "^2.0.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.0.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "opentype.js": "^2.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "resedit": "^3.1.0",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3"
  }
}
